{
  "expo": {
    "name": "NaikamuTV",
    "slug": "naikamu-tv",
    "version": "0.4",
    "scheme": "com.tltcode.naikamutv",
    "platforms": ["android"],
    "icon": "./assets/tv/icon.png",
    "android": {
      "package": "com.tltcode.naikamutv",
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/tv/tv_banner.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/tv/tv_banner.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#222222"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "naikamu-tv",
          "organization": "tltcode"
        }
      ],
      "./plugins/withAndroidTvExtras"
    ]
  }
}
